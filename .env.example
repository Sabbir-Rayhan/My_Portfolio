# Optional: use Web3Forms instead of FormSubmit for the contact form.
# Get a free access key at https://web3forms.com (sent to your inbox), then set it here / in Vercel env vars.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ── AI fallback for the chat (Google Gemini) ──
# Create a free key at https://aistudio.google.com/apikey and set it in Vercel → Settings → Environment Variables.
# One key, or several separated by commas (rotated, with automatic failover when one hits its limit).
GEMINI_API_KEYS=
# Optional: model name (default gemini-flash-latest)
GEMINI_MODEL=
# Optional: AI questions per visitor per 10 minutes (default 8) and per day per server instance (default 400)
AI_RATE_PER_IP=
AI_DAILY_CAP=
